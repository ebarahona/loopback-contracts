<%
// Hand-rendered YAML for a single OAS 3.x `components.schemas.<Name>`
// fragment. Locals from ManifestBackedEmitter: `schema` (raw JSONSchema),
// `className` (PascalCase from schema $id stem), `resolveRef(ref, base)`
// (a `$ref` resolved the way pipeline stage 4 does), `lossy` (the run's
// lossy reporter), `schemaId`.
//
// Projection rules applied here:
//   - Strip top-level `$id` / `$schema` (OAS keys components by the map key).
//   - Inject `type: 'object'` when the schema declares `properties` without
//     an explicit `type` — OAS 3.1 resolvers expect it.
//   - A `$ref` to a whole loaded schema (`money`, `customer.v1`, a URL `$id`,
//     or `#` for this schema) becomes `#/components/schemas/<Component>`,
//     where `<Component>` is the name that schema's own fragment is keyed by.
//   - A `$ref` with a JSON Pointer fragment (`#/$defs/status`,
//     `money#/$defs/amount`) is inlined from the target document, the same
//     rule the zod and types emitters apply; refs inside the inlined
//     subschema resolve against its own document. Root `$defs` /
//     `definitions` are therefore dropped: every use is inlined, and a
//     `#/$defs/...` pointer would resolve against the OpenAPI document, not
//     the component. A fragment that recurses into itself cannot be inlined;
//     that occurrence becomes `{}` and the lossy feature
//     `recursive-fragment-$ref` is reported.
//   - A `$ref` no loaded schema satisfies (an external URL) passes through.
//   - Strip a trailing `.vN` segment from plain-id component names, so
//     `user.v1` keys as `User` (the file path carries the version).
//
// Mounted by the engine's FileWriter under a `#` header comment so the
// whole file stays a valid YAML document.

function stripVersionSuffix(id) {
  return id.replace(/\.v\d+$/, '');
}

function toPascalLocal(s) {
  return String(s)
    .split(/[^A-Za-z0-9]+/)
    .filter(Boolean)
    .map(part => part.charAt(0).toUpperCase() + part.slice(1))
    .join('');
}

function isPlainId(id) {
  return /^[A-Za-z][A-Za-z0-9._-]*$/.test(id);
}

// Component name: strip trailing `.vN` from a plain `$id` so cross-version
// siblings (`user.v1` / `user.v2`) collapse to the same component key under
// OAS, with the file path carrying the version. URL-style ids use the
// emitter's `className` (the schema `title` or the last non-version `$id`
// segment).
function componentNameFor(id, fallback) {
  return isPlainId(id) ? toPascalLocal(stripVersionSuffix(id)) : fallback;
}

const componentName = componentNameFor(schemaId, className);

// `<doc id>#<pointer>` of fragments currently being inlined.
const inlining = new Set();

function escapePointerSegment(seg) {
  return String(seg).replace(/~/g, '~0').replace(/\//g, '~1');
}

function reportRecursiveFragment(ref, path) {
  lossy.report({
    feature: 'recursive-fragment-$ref',
    source: {
      schemaId: schemaId,
      propertyPath: path.map(seg => '/' + escapePointerSegment(seg)).join(''),
    },
    severity: 'warn',
    message: "$ref '" + ref + "' recurses into itself; fragment refs are " +
      'inlined, so the recursive occurrence is emitted as {}.',
    workaround:
      'Move the recursive shape into its own schema file and $ref it by $id.',
  });
}

function projectRef(node, document, path) {
  const ref = node.$ref;
  const siblings = {};
  for (const key of Object.keys(node)) {
    if (key !== '$ref') siblings[key] = projectOAS(node[key], document, false, path.concat(key));
  }
  const hit = resolveRef(ref, document);
  if (hit === undefined) return Object.assign({$ref: ref}, siblings);
  if (hit.pointer === '') {
    const name = componentNameFor(hit.id, hit.className);
    return Object.assign({$ref: '#/components/schemas/' + name}, siblings);
  }
  if (hit.target === undefined) return Object.assign({$ref: ref}, siblings);
  const key = hit.id + '#' + hit.pointer;
  let inlined;
  if (inlining.has(key)) {
    reportRecursiveFragment(ref, path);
    inlined = {};
  } else {
    inlining.add(key);
    try {
      inlined = projectOAS(hit.target, hit.document, false, path);
    } finally {
      inlining.delete(key);
    }
  }
  if (Object.keys(siblings).length === 0) return inlined;
  // 2020-12 applies `$ref` siblings alongside the target; keep both.
  const allOf = [inlined].concat(Array.isArray(siblings.allOf) ? siblings.allOf : []);
  return Object.assign({}, siblings, {allOf: allOf});
}

function projectOAS(node, document, isTopLevel, path) {
  if (Array.isArray(node)) {
    return node.map((child, i) => projectOAS(child, document, false, path.concat(String(i))));
  }
  if (node === null || typeof node !== 'object') return node;
  if (typeof node.$ref === 'string') return projectRef(node, document, path);
  const out = {};
  for (const key of Object.keys(node)) {
    if (isTopLevel && (key === '$id' || key === '$schema')) continue;
    if (isTopLevel && (key === '$defs' || key === 'definitions')) continue;
    out[key] = projectOAS(node[key], document, false, path.concat(key));
  }
  if (node.type === undefined && node.properties !== undefined) {
    out.type = 'object';
  }
  return out;
}

const projected = projectOAS(schema, schema, true, []);

function indent(n) { return '  '.repeat(n); }

function isScalar(v) {
  return v === null || ['string','number','boolean'].includes(typeof v);
}

// Values rendered on the key's own line: scalars and the empty `{}` / `[]`
// flow collections (which need the `: ` separator like a scalar).
function isInline(v) {
  if (v === undefined || isScalar(v)) return true;
  return Array.isArray(v) ? v.length === 0 : Object.keys(v).length === 0;
}

function yamlScalar(v) {
  if (v === null) return 'null';
  if (typeof v === 'boolean' || typeof v === 'number') return String(v);
  const s = String(v);
  // Quote any string that could be misread as another YAML type, contains
  // a YAML-significant character, or has leading/trailing whitespace.
  if (s === '' || /[:#&*!|>'"%@`,\[\]{}?\n\r\t]/.test(s) || /^\s|\s$/.test(s)
    || /^(?:true|false|null|yes|no|on|off|~)$/i.test(s)
    || /^-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?$/.test(s)) {
    return "'" + s.replace(/'/g, "''") + "'";
  }
  return s;
}

function yamlValue(v, depth) {
  if (v === undefined) return 'null';
  if (isScalar(v)) return yamlScalar(v);
  if (Array.isArray(v)) {
    if (v.length === 0) return '[]';
    return '\n' + v.map(item => {
      if (isScalar(item)) return indent(depth) + '- ' + yamlScalar(item);
      return indent(depth) + '- ' + yamlInline(item, depth + 1).replace(/^\n?/, '');
    }).join('\n');
  }
  // object
  const keys = Object.keys(v);
  if (keys.length === 0) return '{}';
  return '\n' + keys.map(k => {
    const child = v[k];
    if (isInline(child)) return indent(depth) + yamlScalar(k) + ': ' + yamlValue(child, depth + 1);
    return indent(depth) + yamlScalar(k) + ':' + yamlValue(child, depth + 1);
  }).join('\n');
}

// Same as yamlValue but always emits an inline `- ` array item's first
// line; subsequent nested keys still go on their own indented lines.
function yamlInline(v, depth) {
  if (isScalar(v)) return yamlScalar(v);
  if (Array.isArray(v)) return yamlValue(v, depth);
  const keys = Object.keys(v);
  if (keys.length === 0) return '{}';
  return keys.map((k, i) => {
    const child = v[k];
    const prefix = i === 0 ? '' : indent(depth);
    const sep = isInline(child) ? ' ' : '';
    return prefix + yamlScalar(k) + ':' + sep + yamlValue(child, depth + 1);
  }).join('\n');
}
-%>
components:
  schemas:
    <%- componentName %>:<%- yamlValue(projected, 3) %>
