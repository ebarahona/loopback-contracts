<%
// Typed CloudEvent<T> wrapper + factory for one source schema. Locals from
// ManifestBackedEmitter: `schema` (raw JSONSchema), `options` (validated
// `x-cloudevents` block — `type` is required), `className` (PascalCase
// from schema $id stem), `schemaId`.
//
// The sibling `<kebab>.types.ts` written by the types emitter supplies
// the payload type; co-enabling `--emit-types` is the documented happy
// path. The import is structural — a missing file surfaces at
// `tsc --noEmit` rather than at codegen.
const Name = className;
const eventType_ = options.type;
const typesImport_ = './' + h.kebab(className) + '.types';
%>import {CloudEvent} from 'cloudevents';
import type {<%- Name %>} from '<%- typesImport_ %>';

/**
 * Typed CloudEvent envelope carrying a `<%- Name %>` payload.
 */
export type <%- Name %>Event = CloudEvent<<%- Name %>>;

/**
 * Init shape for {@link create<%- Name %>Event}. `type` is pinned to the
 * declared `x-cloudevents.type`; consumers supply `source` / `subject` /
 * `data` per emit.
 */
export interface <%- Name %>EventInit {
  type: '<%- h.escapeStr(eventType_) %>';
  source: string;
  subject?: string;
  data: <%- Name %>;
  datacontenttype?: 'application/json';
  time?: string;
  id?: string;
}

/**
 * Factory for a fully-typed `<%- Name %>Event`. Fills in `specversion: '1.0'`
 * and defaults `datacontenttype` to `application/json` when omitted.
 */
export function create<%- Name %>Event(init: <%- Name %>EventInit): <%- Name %>Event {
  return new CloudEvent<<%- Name %>>({
    ...init,
    specversion: '1.0',
    datacontenttype: init.datacontenttype ?? 'application/json',
  });
}
