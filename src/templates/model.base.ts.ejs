<%
/**
 * Base model template.
 *
 * View-model fields (see ModelGenerator.buildViewModel):
 *   className          string                  e.g. "Customer"
 *   baseClass          "Entity" | "Model"
 *   modelSettings      Record<string,unknown>  passed verbatim to @model({settings})
 *   imports            Array<{specifier, names: string[], typeOnly: boolean}>
 *   properties         Array<PropertyView>
 *   relations          Array<RelationView>
 *
 * PropertyView:
 *   name           string
 *   tsType         string
 *   required       boolean
 *   optionsLiteral string   raw @property({...}) options object literal
 *
 * RelationView:
 *   name           string  field name
 *   kind           "belongsTo" | "hasMany" | "hasOne" | "hasManyThrough" | "referencesMany"
 *   targetClass    string  referenced model class name (resolved via import map)
 *   tsType         string  field type literal (e.g. "Order[]" for hasMany)
 *   optionsLiteral string  raw decorator options object literal (may be "{}")
 *   keyFromLiteral string  raw `{keyFrom: '...'}` options or "" when none
 */
-%>
import {<%- baseClass %>, model, property<% relations.forEach(function(r){ -%>, <%- r.kind %><% }); %>} from '@loopback/repository';
<% imports.forEach(function(imp){ -%>
import <% if (imp.typeOnly) { -%>type <% } -%>{<%- imp.names.join(', ') %>} from '<%- imp.specifier %>';
<% }); -%>

/**
 * Base class for {@link <%- className %>}.
 *
 * Regenerated by `lb4 gen`; do not hand-edit. Hand-customisations belong in
 * the extension file (`<%- h.kebab(className) %>.model.ts`) created by
 * `lb4 override model <%- h.kebab(className) %>`.
 *
 * @internal
 */
@model(<%- modelSettings %>)
export class <%- className %>Base extends <%- baseClass %> {
<% properties.forEach(function(p){ -%>
  @property(<%- p.optionsLiteral %>)
  <%- p.name %><%- p.required ? '!' : '?' %>: <%- p.tsType %><%- p.required ? '' : ' | undefined' %>;

<% }); -%>
<% relations.forEach(function(r){ -%>
  @<%- r.kind %>(() => <%- r.targetClass %><%- r.optionsArg %>)
  <%- r.name %><%- r.fieldDecl %>;

<% }); -%>
  constructor(data?: Partial<<%- className %>Base>) {
    super(data);
  }
}

export interface <%- className %>BaseRelations {
<% relations.forEach(function(r){ -%>
  <%- r.name %>?: <%- r.relationsType %>;
<% }); -%>
}

export type <%- className %>BaseWithRelations = <%- className %>Base & <%- className %>BaseRelations;
