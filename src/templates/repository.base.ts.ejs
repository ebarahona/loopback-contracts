<%
/**
 * Base repository template.
 *
 * View-model fields:
 *   className           string   e.g. "Customer"
 *   baseClassName       string   e.g. "CustomerBase"
 *   relationsTypeName   string   e.g. "CustomerBaseRelations"
 *   idType              string   TS literal of the model's id property type
 *   dataSourceName      string   e.g. "primary"
 *   dataSourceClass     string   e.g. "PrimaryDataSource"
 *   modelImportPath     string   relative path (no extension) to the base model file
 *   dataSourceImportPath string  relative path (no extension) to the datasource file
 *   factoryImports      string[] sorted unique repository-factory fn names
 *   relations           Array<RelationRepoView>
 *
 * RelationRepoView:
 *   name                 string  field name on the model (e.g., "orders")
 *   accessorName         string  e.g., "orders"
 *   factoryFnName        string  e.g., "createHasManyRepositoryFactoryFor"
 *   factoryReturnType    string  e.g., "HasManyRepositoryFactory<Order, typeof CustomerBase.prototype.id>"
 *   targetClass          string  e.g., "Order"
 *   targetWithRelations  string  e.g., "OrderWithRelations"
 *   targetRepoClass      string  e.g., "OrderRepository"
 *   targetImportPath     string  relative path (no extension) to the target model file
 *   targetRepoImportPath string  relative path (no extension) to the target repository file
 *   getterName           string  e.g., "ordersGetter"
 *   relationName         string  e.g., "orders" (matches the @hasMany name)
 *   factoryTypeImport    string  e.g., "HasManyRepositoryFactory"
 */
-%>
import {inject, Getter} from '@loopback/core';
import {
  DefaultCrudRepository,
  juggler,
  repository,
<% factoryImports.forEach(function(f, i){ -%>
  <%- f %><%- (i === factoryImports.length - 1 && factoryTypeImports.length === 0) ? '' : ',' %>
<% }); -%>
<% factoryTypeImports.forEach(function(t, i){ -%>
  <%- t %><%- i === factoryTypeImports.length - 1 ? '' : ',' %>
<% }); -%>
} from '@loopback/repository';
import {<%- baseClassName %>, <%- relationsTypeName %>} from '<%- modelImportPath %>';
import {<%- dataSourceClass %>} from '<%- dataSourceImportPath %>';
<% relations.forEach(function(r){ -%>
import type {<%- r.targetClass %>, <%- r.targetWithRelations %>} from '<%- r.targetImportPath %>';
import type {<%- r.targetRepoClass %>} from '<%- r.targetRepoImportPath %>';
<% }); -%>

/**
 * Base repository for {@link <%- baseClassName %>}.
 *
 * Regenerated by `lb4 gen`; do not hand-edit. Custom finders, transaction
 * helpers, and overrides belong in the extension file
 * (`<%- h.kebab(className) %>.repository.ts`).
 *
 * @internal
 */
export class <%- className %>BaseRepository extends DefaultCrudRepository<
  <%- baseClassName %>,
  <%- idType %>,
  <%- relationsTypeName %>
> {
<% relations.forEach(function(r){ -%>
  public readonly <%- r.accessorName %>: <%- r.factoryReturnType %>;

<% }); -%>
  constructor(
    @inject('datasources.<%- dataSourceName %>') dataSource: <%- dataSourceClass %><% relations.forEach(function(r){ -%>,
    @repository.getter('<%- r.targetRepoClass %>') <%- r.getterName %>: Getter<<%- r.targetRepoClass %>><% }); %>,
  ) {
    super(<%- baseClassName %>, dataSource);
<% relations.forEach(function(r){ -%>
    this.<%- r.accessorName %> = this.<%- r.factoryFnName %>('<%- r.relationName %>', <%- r.getterName %>);
<% }); -%>
  }
}
